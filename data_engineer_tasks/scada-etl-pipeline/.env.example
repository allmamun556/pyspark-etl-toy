# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scada
POSTGRES_USER=scada_user
POSTGRES_PASSWORD=change_me_in_prod

# --- Pipeline behavior ---
# Number of turbines the simulator generates readings for
TURBINE_COUNT=20
# Simulated reading interval in seconds (10-min SCADA intervals is typical in wind)
READING_INTERVAL_SECONDS=600
# Rows per batch for COPY-based loading
LOAD_BATCH_SIZE=5000
# Physical validation bounds
MAX_WIND_SPEED_MS=45
MAX_POWER_KW=3500
MAX_ROTOR_RPM=20
MIN_NACELLE_TEMP_C=-30
MAX_NACELLE_TEMP_C=60

# --- Logging ---
LOG_LEVEL=INFO

# --- Airflow (used by docker-compose.yml) ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
