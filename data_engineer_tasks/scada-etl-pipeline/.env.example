# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scada
POSTGRES_USER=scada_user
POSTGRES_PASSWORD=change_me_in_prod
# Host-side port for docker-compose.yml's postgres port mapping. Only
# change this if 5432 is already taken by something else on your machine -
# it has no effect on POSTGRES_PORT above, which containers use internally.
# POSTGRES_HOST_PORT=5432

# --- Pipeline behavior ---
# Number of turbines the simulator generates readings for
TURBINE_COUNT=20
# Number of solar plants the simulator generates readings for
SOLAR_PLANT_COUNT=8
# Simulated reading interval in seconds (10-min SCADA intervals is typical in wind)
READING_INTERVAL_SECONDS=600
# Rows per batch for COPY-based loading
LOAD_BATCH_SIZE=5000
# Physical validation bounds
MAX_WIND_SPEED_MS=45
MAX_POWER_KW=3500
MAX_ROTOR_RPM=20
MIN_NACELLE_TEMP_C=-30
MAX_NACELLE_TEMP_C=60

# --- Logging ---
LOG_LEVEL=INFO

# --- Alerting ---
# Slack incoming-webhook URL for DAG failure notifications. Leave unset to
# disable - src/utils/alerting.py logs instead of posting when this is
# empty, so alerting being unconfigured never breaks a pipeline run.
# Create one at https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Airflow (used by docker-compose.yml) ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
